# Server Configuration
PORT=5000
NODE_ENV=development

# HDFC SmartGateway API Configuration
# Environment options: SANDBOX or PRODUCTION
HDFC_ENV=SANDBOX

# Credentials obtained from HDFC SmartGateway / Juspay Merchant Dashboard
HDFC_MERCHANT_ID=your_hdfc_merchant_id
HDFC_CLIENT_ID=your_hdfc_client_id
HDFC_API_KEY=your_hdfc_api_key

# Base URLs
APP_BASE_URL=http://localhost:5000
RETURN_URL=http://localhost:5000/api/payment-return

# Supabase Order Storage & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Course Pricing Configuration (in INR)
OFFER_PRICE=499
REGULAR_PRICE=899
TEST_PRICE=2  # Set to 2 to test initial payment with ₹2, or comment out for actual prices

