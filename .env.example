# Server Configuration
PORT=5000
NODE_ENV=development

# HDFC SmartGateway API Configuration
# Environment options: SANDBOX or PRODUCTION
HDFC_ENV=SANDBOX

# Credentials obtained from HDFC SmartGateway / Juspay Merchant Dashboard
HDFC_MERCHANT_ID=your_hdfc_merchant_id
HDFC_CLIENT_ID=your_hdfc_client_id
HDFC_API_KEY=your_hdfc_api_key

# Base URLs
APP_BASE_URL=http://localhost:5000
RETURN_URL=http://localhost:5000/payment-status.html

# Course Pricing Configuration (in INR)
OFFER_PRICE=499
REGULAR_PRICE=899
TEST_PRICE=1  # Set to 1 to test initial payment with ₹1, or comment out for actual prices

